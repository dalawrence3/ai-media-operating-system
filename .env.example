# Environment variables for the AI Content Production Engine.
#
# Copy this file to .env (git-ignored) and fill in real values there.
# Never commit real credentials to the repository.
#
# The application starts and runs non-AI commands without any API keys set.

# ── Database (Phase 1) ────────────────────────────────────────────────────────
# ACE_DB_PATH=~/.local/share/ai-content-engine/content.db
# ACE_LOG_LEVEL=WARNING

# ── AI / LLM (Phase 2) ────────────────────────────────────────────────────────
# API key for the Anthropic Claude provider.
# Leave unset to use the fake provider (safe for development and tests).
# ACE_ANTHROPIC_API_KEY=

# Provider to use: "fake" (default, no API key needed) or "claude".
# ACE_AI_PROVIDER=fake

# Claude model to use when provider is "claude".
# ACE_AI_MODEL=claude-sonnet-5

# Request timeout in seconds for the Claude provider.
# ACE_AI_TIMEOUT=30

# Maximum number of retry attempts on transient provider errors.
# ACE_AI_MAX_RETRIES=3

# Set to "1" to force the fake provider regardless of ACE_AI_PROVIDER.
# Useful for CI and local development to prevent accidental API calls.
# ACE_DRY_RUN=1

# Optional path to a JSON pricing-override file (same structure as the
# built-in registry in src/app/ai/pricing.py).
# ACE_AI_PRICING_FILE=

# ── Narration / TTS (Phase 6, provider TBD) ──────────────────────────────────
# <TTS provider credential — added at Phase 6>

# ── YouTube (Phase 10) ────────────────────────────────────────────────────────
# <OAuth client id/secret — added at Phase 10>
