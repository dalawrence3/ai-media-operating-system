# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment
.venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/

# Environment / secrets — NEVER commit real credentials
.env
.env.local

# Dev server process IDs
.pids/

# Playwright artifacts
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/

# Google OAuth client secrets — NEVER commit these
client_secret*.json
client_secrets*.json
*_client_secret.json
*_client_secrets.json
credentials.json

# OAuth token files (written by LocalFileTokenStore)
oauth_tokens/

# Data (introduced in later phases)
*.db
*.sqlite3

# Generated media (introduced in later phases)
/output/
/media/

# Audio artifacts — never committed (M6.2)
/artifacts/

# macOS
.DS_Store

# Editor
.vscode/
