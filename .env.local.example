# Local development overrides — copy this file to .env.local (git-ignored).
# .env.local is NEVER committed to the repository.
# Credentials and API keys go here, not in .env.example.

# ── Runtime mode ──────────────────────────────────────────────────────────────
ACE_ENV=development
ACE_DEV_AUTH=enabled

# ── Safety gates — keep false in local dev ────────────────────────────────────
ACE_PUBLISHING_LIVE_ENABLED=false
ACE_TTS_LIVE_ENABLED=false
ACE_DRY_RUN=1

# ── Fake providers (no API key needed) ───────────────────────────────────────
ACE_AI_PROVIDER=fake
ACE_TTS_PROVIDER=fake

# ── Logging ───────────────────────────────────────────────────────────────────
ACE_LOG_FORMAT=console
ACE_LOG_LEVEL=INFO

# ── Database — SQLite (default path is ~/.local/share/ai-content-engine/content.db) ──
# Uncomment to use a custom path:
# ACE_DB_PATH=/Users/you/projects/ace-dev.db

# ── Frontend origin (for OAuth callback redirects) ────────────────────────────
ACE_FRONTEND_URL=http://localhost:5173

# ── YouTube OAuth (optional — only needed if testing real OAuth) ──────────────
# YOUTUBE_CLIENT_SECRETS_PATH=/Users/you/.config/ace/client_secret.json
# ACE_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/youtube/callback
# ACE_YOUTUBE_TOKEN_DIR=/Users/you/.local/share/ai-content-engine/oauth_tokens

# ── AI (optional — only needed if testing real Claude calls) ─────────────────
# ACE_ANTHROPIC_API_KEY=sk-ant-...
# ACE_AI_PROVIDER=claude
# ACE_AI_MODEL=claude-haiku-4-5-20251001

# ── ElevenLabs TTS (optional — only needed if testing live synthesis) ─────────
# ACE_ELEVENLABS_API_KEY=...
# ACE_TTS_LIVE_ENABLED=true
# ACE_TTS_PROVIDER=elevenlabs
